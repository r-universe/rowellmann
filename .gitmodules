[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "optiSel"]
	path = optiSel
	url = https://github.com/cran/optiSel
[submodule "optiSolve"]
	path = optiSolve
	url = https://github.com/cran/optiSolve
[submodule "sumer"]
	path = sumer
	url = https://github.com/cran/sumer
